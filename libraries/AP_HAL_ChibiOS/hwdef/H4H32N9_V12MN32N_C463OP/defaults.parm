#---NOTCH FILTER High-pass notch filter for the IMU
# NOTE: Conservative starting values for new powerplant – update after first flight log analysis
INS_HNTCH_ENABLE 1        # Enable harmonic notch filtering
INS_HNTCH_FM_RAT 0.75     # Frequency multiplier for throttle-based notch tracking
INS_HNTCH_ATT 40          # Attenuation level of the notch filter [dB] – raise after log review
INS_HNTCH_BW 15           # Notch filter bandwidth [Hz] – widen after log review
INS_HNTCH_FREQ 31         # Base notch center frequency [Hz] – estimated from 32" prop hover RPM (~1875 RPM)
INS_HNTCH_HMNCS 3         # Harmonics bitmask: 1st + 2nd only (sufficient for 32" props)
INS_HNTCH_MODE 1          # Harmonic notch mode (1 = throttle-based)
INS_HNTCH_OPTS 16         # Harmonic notch options bitmask (double-notch)
INS_HNTCH_REF 0.2         # Reference throttle – update to MOT_THST_HOVER after first hover
INS_GYRO_FILTER 20        # Gyroscope low-pass filter cutoff frequency [Hz]
INS_ACCEL_FILTER 10       # Accelerometer low-pass filter cutoff frequency [Hz]