ATC_RAT_YAW_FLTE 2        # Yaw rate error filter cutoff [Hz]
ATC_RAT_YAW_FLTT 10       # Yaw rate target filter cutoff [Hz]
ATC_RAT_YAW_I 0.05        # Yaw rate controller integral gain
ATC_RAT_YAW_IMAX 0.5      # Maximum yaw rate integrator output
ATC_RAT_YAW_NEF 0         # Yaw rate notch enable frequency (0 = disabled)
ATC_RAT_YAW_NTF 0         # Yaw rate notch tracking frequency (0 = disabled)
ATC_RAT_YAW_P 0.5         # Yaw rate controller proportional gain
ATC_RAT_YAW_PDMX 0        # Yaw rate PD mix (0 = disabled)
ATC_RAT_YAW_SMAX 0        # Yaw rate output slew limit (0 = unlimited)

ATC_RATE_FF_ENAB 1        # Enable rate feedforward control
ATC_RATE_P_MAX 0          # Maximum pitch rate [deg/s] (0 = use default)
ATC_RATE_R_MAX 0          # Maximum roll rate [deg/s] (0 = use default)
ATC_RATE_Y_MAX 0          # Maximum yaw rate [deg/s] (0 = use default)

