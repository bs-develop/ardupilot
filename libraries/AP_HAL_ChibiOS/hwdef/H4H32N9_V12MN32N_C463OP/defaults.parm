ATC_RAT_RLL_I 0.08        # Roll rate controller integral gain
ATC_RAT_RLL_IMAX 0.5      # Maximum roll rate integrator output
ATC_RAT_RLL_NEF 0         # Roll rate notch enable frequency (0 = disabled)
ATC_RAT_RLL_NTF 0         # Roll rate notch tracking frequency (0 = disabled)
ATC_RAT_RLL_P 0.08        # Roll rate controller proportional gain
ATC_RAT_RLL_PDMX 0        # Roll rate PD mix (0 = disabled)
ATC_RAT_RLL_SMAX 0        # Roll rate output slew limit (0 = unlimited)

ATC_RAT_YAW_D 0           # Yaw rate controller derivative gain
ATC_RAT_YAW_D_FF 0        # Yaw rate derivative feedforward gain
