ATC_ANG_YAW_P 4.5         # Yaw angle controller proportional gain

ATC_ANGLE_BOOST 1         # Enable throttle boost based on vehicle lean angle
ATC_INPUT_TC 0.2          # Pilot input smoothing time constant [seconds]

ATC_RAT_PIT_D 0.002       # Pitch rate controller derivative gain
ATC_RAT_PIT_D_FF 0        # Pitch rate derivative feedforward gain
