ATC_ACCEL_P_MAX 19100     # Maximum pitch angular acceleration [deg/s²]
ATC_ACCEL_R_MAX 19100     # Maximum roll angular acceleration [deg/s²]
ATC_ACCEL_Y_MAX 8000      # Maximum yaw angular acceleration [deg/s²]

